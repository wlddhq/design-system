{
  "name": "@wldd/tailwind",
  "license": "MIT",
  "version": "0.1.3",
  "description": "Tailwind v4 theme for WLDD. Replaces Tailwind's defaults with WLDD tokens only.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "style": "./theme.css",
  "exports": {
    ".": {
      "style": "./theme.css",
      "default": "./theme.css"
    },
    "./theme.css": "./theme.css"
  },
  "files": [
    "theme.css"
  ],
  "peerDependencies": {
    "@wldd/tokens": "^0.1.0",
    "tailwindcss": "^4.0.0"
  },
  "scripts": {
    "build": "node -e \"\"",
    "prepublishOnly": "node ../../scripts/release-check.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "wldd",
    "design-system",
    "react",
    "tailwind",
    "tokens"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wlddhq/design-system.git",
    "directory": "packages/tailwind"
  },
  "bugs": {
    "url": "https://github.com/wlddhq/design-system/issues"
  },
  "homepage": "https://github.com/wlddhq/design-system#readme"
}
