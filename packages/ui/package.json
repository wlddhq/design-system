{
  "name": "@wldd/ui",
  "license": "MIT",
  "version": "0.1.6",
  "description": "WLDD React components. Import styles once: import '@wldd/ui/styles.css'",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./meta/*": "./dist/meta/*",
    "./rules/*": "./dist/rules/*",
    "./AGENTS.md": "./dist/AGENTS.md"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/fix-imports.mjs && node scripts/build-css.mjs && node scripts/build-meta.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/release-check.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@wldd/tokens": "^0.1.0",
    "lucide-react": ">=0.400.0 <2.0.0",
    "motion": "^12.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wldd/tokens": "*",
    "axe-core": "^4.14.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.77.0",
    "motion": "^12.42.2",
    "react": "^19.0.0",
    "react-docgen-typescript": "^2.2.2",
    "react-dom": "^19.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "cmdk": "^1.1.1",
    "sonner": "^1.7.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "wldd",
    "design-system",
    "react",
    "tailwind",
    "tokens"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wlddhq/design-system.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/wlddhq/design-system/issues"
  },
  "homepage": "https://github.com/wlddhq/design-system#readme"
}
