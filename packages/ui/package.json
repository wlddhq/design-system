{
  "name": "@wldd/ui",
  "license": "MIT",
  "version": "0.1.3",
  "description": "WLDD React components. Import styles once: import '@wldd/ui/styles.css'",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./meta/*": "./dist/meta/*",
    "./rules/*": "./dist/rules/*",
    "./AGENTS.md": "./dist/AGENTS.md"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/fix-imports.mjs && node scripts/build-css.mjs && node scripts/build-meta.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/release-check.mjs"
  },
  "peerDependencies": {
    "@wldd/tokens": "^0.1.0",
    "lucide-react": ">=0.400.0",
    "motion": ">=12.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wldd/tokens": "*",
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "react": "^19.0.0",
    "react-docgen-typescript": "^2.2.2",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "cmdk": "^1.1.1",
    "sonner": "^1.7.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "wldd",
    "design-system",
    "react",
    "tailwind",
    "tokens"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wlddhq/design-system.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/wlddhq/design-system/issues"
  },
  "homepage": "https://github.com/wlddhq/design-system#readme"
}
