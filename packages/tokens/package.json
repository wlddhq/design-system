{
  "name": "@wldd/tokens",
  "license": "MIT",
  "version": "0.1.2",
  "description": "WLDD design tokens: colours, type, radii and motion for every theme, as CSS variables.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/release-check.mjs"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "wldd",
    "design-system",
    "react",
    "tailwind",
    "tokens"
  ],
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wlddhq/design-system.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/wlddhq/design-system/issues"
  },
  "homepage": "https://github.com/wlddhq/design-system#readme"
}
